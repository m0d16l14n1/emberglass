[Unit]
Description=emberglass sensor sampler (/run/emberglass, for panels and HUDs)
Documentation=https://github.com/m0d16l14n1/emberglass
After=sysinit.target

[Service]
Type=simple
ExecStart=/usr/bin/env python3 -I @LIBDIR@/emberglass-sampler
Restart=on-failure
RestartSec=5
Nice=10
# Reads sysfs/procfs, writes /run/emberglass only. The files stay when it stops (they then say "paused").
RuntimeDirectory=emberglass
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
MemoryMax=64M

[Install]
WantedBy=multi-user.target
